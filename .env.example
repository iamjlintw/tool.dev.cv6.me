# FTP 同步設定
# 複製成 .env 再填。.env 已列入 .gitignore，不會進版控。
#
#   cp .env.example .env
#   ./ftp-sync.sh                  互動選單，問要 push 還是 pull
#   ./ftp-sync.sh push --dry-run   先比對，確認要動哪些檔
#   ./ftp-sync.sh push             本機 → 遠端
#   ./ftp-sync.sh pull             遠端 → 本機

# 主機位址（IP 或網域，不要加 ftp:// ）
FTP_HOST=

# FTP 帳號與密碼
FTP_USER=
FTP_PASSWORD=

# 連接埠，一般是 21
FTP_PORT=21

# 是否走 FTPS（explicit TLS）。主機沒開 TLS 才設 false，
# 但那表示密碼會以明文在網路上傳輸，建議先在主機把 TLS 開起來。
FTP_SECURE=true

# 若主機用自簽憑證導致 TLS 驗證失敗，才把這行設成 false
FTP_REJECT_UNAUTHORIZED=true

# 站台在遠端的根目錄。
# FTP 帳號通常已被鎖在站台根目錄，此時填 / 即可；
# 若帳號看得到整台機器，就填完整路徑，例如 /www/wwwroot/tool.dev.cv6.me
FTP_REMOTE_DIR=/
